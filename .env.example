# Aegis Search & Research Engine Environment Configuration

# Core App Settings
APP_NAME="Aegis Search & Research Engine"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Database Credentials
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_password
POSTGRES_DB=aegis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database URLs
DATABASE_URL="postgresql+asyncpg://aegis:aegis_password@localhost:5432/aegis"
SYNC_DATABASE_URL="postgresql+psycopg2://aegis:aegis_password@localhost:5432/aegis"

# Derived Storage Services
OPENSEARCH_URL="http://localhost:9200"
QDRANT_URL="http://localhost:6333"
REDIS_URL="redis://localhost:6379/0"
OLLAMA_URL="http://localhost:11434"

# Security & CORS
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'
